# Normalize line endings so the repository content is identical on Windows,
# macOS, Linux, and CI runners.
* text=auto eol=lf

# Shell scripts must keep LF even when checked out on Windows.
*.sh text eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
