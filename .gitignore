htmlcov/
coverage.xml

# --- Node / Next.js ---
node_modules/
# Any build directory, not only the default one. A run with a custom distDir
# left 160 files of `.next-local-auth` sitting untracked, and `git add apps`
# duly staged all of them.
.next*/
out/
.turbo/
*.tsbuildinfo
.eslintcache
coverage/

# --- Editors & OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Local infrastructure state ---
.docker-data/
pgdata/
redisdata/

# --- Logs & temporary files ---
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
tmp/
.tmp/

# Local agent/editor tooling state
.claude/

# Clerk keyless-mode instance keys
.clerk/

# Personal, uncommitted notes
*.local.md

# --- Playwright ---
# Traces and screenshots from a failed e2e run. Kept locally so a failure can be
# opened, never committed: a trace is megabytes and describes one machine's run.
test-results/
playwright-report/
blob-report/
.playwright/
