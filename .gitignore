# --- Secrets & local environment ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
secrets/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
