# Web app environment.
#
#   cp .env.example .env.local
#
# NEXT_PUBLIC_ values are inlined into the browser bundle, so anything with that
# prefix is public. CLERK_SECRET_KEY must never gain one — that single rename
# would publish the secret to every visitor, with no error and nothing visibly
# broken.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Clerk ---
# From the Clerk dashboard, API Keys. Development keys are prefixed pk_test_ /
# sk_test_; production keys pk_live_ / sk_live_.
#
# With both left empty, Clerk runs in keyless mode in development: it
# provisions a temporary instance and prints a claim link in the dev server
# output. Useful for a first run, but the instance is not yours until claimed,
# so set real keys before doing anything you want to keep.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
