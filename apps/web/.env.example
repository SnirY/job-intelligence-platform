# Web app environment.
#
#   cp .env.example .env.local
#
# NEXT_PUBLIC_ values are inlined into the browser bundle, so anything with that
# prefix is public. CLERK_SECRET_KEY must never gain one — that single rename
# would publish the secret to every visitor, with no error and nothing visibly
# broken.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Clerk ---
# From the Clerk dashboard, API Keys. Development keys are prefixed pk_test_ /
# sk_test_; production keys pk_live_ / sk_live_.
#
# With both left empty, Clerk runs in keyless mode in development: it
# provisions a temporary instance and prints a claim link in the dev server
# output. Useful for a first run, but the instance is not yours until claimed,
# so set real keys before doing anything you want to keep.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Local mode: no Clerk, no account ---
# Set both, and set the API's JIP_AUTH_PROVIDER=local and JIP_AUTH_LOCAL_SECRET
# to the SAME secret. /sign-in then asks for a name instead of credentials, and
# the name becomes the profile.
#
#   NEXT_PUBLIC_AUTH_PROVIDER=local
#   AUTH_LOCAL_SECRET=<at least 32 characters, identical to the API's>
#
# The two halves failing to match is the one mistake worth naming: sign-in
# succeeds and every request afterwards returns 401, which reads like a broken
# product rather than a misconfiguration.
#
# AUTH_LOCAL_SECRET has no NEXT_PUBLIC_ prefix and must never gain one. Tokens
# are minted in a route handler precisely so the secret stays on the server;
# publishing it would let any visitor mint a token for any name.
NEXT_PUBLIC_AUTH_PROVIDER=
AUTH_LOCAL_SECRET=
