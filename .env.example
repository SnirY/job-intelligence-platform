# Local development environment.
#
#   cp .env.example .env
#
# .env is git-ignored. Never put a real credential in this file — it is
# committed, and every value here is a local-only placeholder.

# --- Runtime ---
JIP_ENVIRONMENT=local
JIP_LOG_LEVEL=INFO

# --- PostgreSQL ---
# Consumed by docker-compose to provision the container.
POSTGRES_USER=jip
POSTGRES_PASSWORD=jip_local_dev_only
POSTGRES_DB=jip
POSTGRES_PORT=5432

# Consumed by the API and worker. Inside Compose the host is `postgres`;
# running the API on the host directly, it is `localhost`.
JIP_DATABASE_URL=postgresql+psycopg://jip:jip_local_dev_only@localhost:5432/jip

# --- Redis ---
REDIS_PORT=6379
JIP_REDIS_URL=redis://localhost:6379/0

# --- API ---
JIP_API_HOST=127.0.0.1
JIP_API_PORT=8000
JIP_CORS_ALLOWED_ORIGINS=http://localhost:3000
JIP_CONNECT_TIMEOUT_SECONDS=5

# --- Worker ---
JIP_WORKER_QUEUES=default

# --- Authentication ---
# Provider-neutral by design (ADR-0005): these are OIDC settings, so moving to a
# different issuer is configuration rather than code.
#
# The API verifies session tokens offline against the issuer's public JWKS, so
# it needs NO provider secret. If a Clerk secret key ever appears here,
# something has been wired wrong.

# Recorded on each new user row, so two issuers can coexist during a migration.
JIP_AUTH_PROVIDER=clerk

# Expected `iss` claim. In the Clerk dashboard under API Keys this is your
# Frontend API URL, e.g. https://your-app.clerk.accounts.dev
JIP_AUTH_ISSUER=

# Comma-separated origins permitted in the token's `azp` claim. Leaving this
# empty disables the check, which allows a token minted for a different
# application to be accepted here. Set it.
JIP_AUTH_AUTHORIZED_PARTIES=http://localhost:3000

# --- Object storage (S3-compatible) ---
# Uploaded resumes never go in the database. Compose runs MinIO; production
# points the same adapter at S3 or R2 by changing the endpoint.
JIP_STORAGE_BUCKET=jip-documents
JIP_STORAGE_ENDPOINT_URL=http://localhost:9000
JIP_STORAGE_ACCESS_KEY=jip_local_dev_only
JIP_STORAGE_SECRET_KEY=jip_local_dev_only

# Uploads are read into memory to hash and inspect before storing, so the
# ceiling is a denial-of-service control, not just a product limit.
JIP_MAX_UPLOAD_BYTES=10485760

# --- Web ---
# NEXT_PUBLIC_ values are inlined into the browser bundle. Public only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
