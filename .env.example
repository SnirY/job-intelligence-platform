# Local development environment.
#
#   cp .env.example .env
#
# .env is git-ignored. Never put a real credential in this file — it is
# committed, and every value here is a local-only placeholder.

# --- Runtime ---
JIP_ENVIRONMENT=local
JIP_LOG_LEVEL=INFO

# --- PostgreSQL ---
# Consumed by docker-compose to provision the container.
POSTGRES_USER=jip
POSTGRES_PASSWORD=jip_local_dev_only
POSTGRES_DB=jip
POSTGRES_PORT=5432

# Consumed by the API and worker. Inside Compose the host is `postgres`;
# running the API on the host directly, it is `localhost`.
JIP_DATABASE_URL=postgresql+psycopg://jip:jip_local_dev_only@localhost:5432/jip

# --- Redis ---
REDIS_PORT=6379
JIP_REDIS_URL=redis://localhost:6379/0

# --- API ---
JIP_API_HOST=127.0.0.1
JIP_API_PORT=8000
JIP_CORS_ALLOWED_ORIGINS=http://localhost:3000
JIP_CONNECT_TIMEOUT_SECONDS=5

# --- Worker ---
JIP_WORKER_QUEUES=default

# --- Authentication ---
# Provider-neutral by design (ADR-0005): these are OIDC settings, so moving to a
# different issuer is configuration rather than code.
#
# The API verifies session tokens offline against the issuer's public JWKS, so
# it needs NO provider secret. If a Clerk secret key ever appears here,
# something has been wired wrong.

# Recorded on each new user row, so two issuers can coexist during a migration.
JIP_AUTH_PROVIDER=clerk

# Expected `iss` claim. In the Clerk dashboard under API Keys this is your
# Frontend API URL, e.g. https://your-app.clerk.accounts.dev
JIP_AUTH_ISSUER=

# Comma-separated origins permitted in the token's `azp` claim. Leaving this
# empty disables the check, which allows a token minted for a different
# application to be accepted here. Set it.
JIP_AUTH_AUTHORIZED_PARTIES=http://localhost:3000

# --- Object storage (S3-compatible) ---
# Uploaded resumes never go in the database. Compose runs MinIO; production
# points the same adapter at S3 or R2 by changing the endpoint.
JIP_STORAGE_BUCKET=jip-documents
JIP_STORAGE_ENDPOINT_URL=http://localhost:9000
JIP_STORAGE_ACCESS_KEY=jip_local_dev_only
JIP_STORAGE_SECRET_KEY=jip_local_dev_only
# Unset for MinIO, which has no key service. On AWS S3 set only when a
# specific algorithm or KMS key is required; S3 encrypts at rest by default.
JIP_STORAGE_SERVER_SIDE_ENCRYPTION=

# Uploads are read into memory to hash and inspect before storing, so the
# ceiling is a denial-of-service control, not just a product limit.
JIP_MAX_UPLOAD_BYTES=10485760

# --- AI ---
# Resume parsing is the first AI feature. With no key set, an import still
# uploads and stores the file and then fails with a clear PROVIDER_ERROR — the
# platform never returns invented results when AI is unavailable
# (docs/11-engineering-standards.md).
JIP_AI_PROVIDER=anthropic
JIP_AI_API_KEY=

# Model routing is configuration, not code (docs/05-ai-and-matching.md), so a
# cost or quality decision can be revisited without a deploy.
JIP_AI_RESUME_PARSE_MODEL=claude-opus-5
JIP_AI_RESUME_PARSE_MAX_OUTPUT_TOKENS=16000
# Reasoning depth, when the provider exposes one. Extraction rarely needs the
# ceiling; leave empty to use the provider's own default.
JIP_AI_RESUME_PARSE_EFFORT=medium

# Attempts per AI operation, including the first. Each one is traced in ai_runs.
JIP_AI_MAX_ATTEMPTS=3
JIP_AI_REQUEST_TIMEOUT_SECONDS=120

# Ceiling on document text sent to a model. A resume is a few thousand
# characters; truncation is reported to the user, never hidden.
JIP_AI_MAX_INPUT_CHARS=60000

# Job intelligence routes two operations, because they are two different tasks:
# parsing reads the posting into requirements, analysis interprets it into a
# role family and a seniority. Leave either model empty to fall back to
# JIP_AI_RESUME_PARSE_MODEL.
JIP_AI_JOB_PARSE_MODEL=
JIP_AI_JOB_PARSE_MAX_OUTPUT_TOKENS=16000
JIP_AI_JOB_PARSE_EFFORT=medium

# Smaller ceiling: the analysis returns a handful of fields and its reasoning,
# not every requirement in the posting.
JIP_AI_JOB_ANALYSIS_MODEL=
JIP_AI_JOB_ANALYSIS_MAX_OUTPUT_TOKENS=4000
JIP_AI_JOB_ANALYSIS_EFFORT=medium

# --- Job URL import ---
# Fetching a job posting means asking our server to open a link a user supplied,
# so both limits below are abuse controls first and product settings second: a
# slow host must not tie up a worker, and a large response must not be read into
# memory. The SSRF rules (scheme, port, and address allowlists) are not
# configurable — see apps/api/src/jip_api/infrastructure/fetching/safety.py.
JIP_JOB_FETCH_TIMEOUT_SECONDS=15
JIP_JOB_FETCH_MAX_BYTES=3145728

# --- Web ---
# NEXT_PUBLIC_ values are inlined into the browser bundle. Public only.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Explaining a finished match. Explanation only: the score, the statuses, and
# the recommendation are all decided deterministically before this runs, and no
# field the model returns can move a number. Empty falls back to the resume model.
JIP_AI_MATCH_EXPLAIN_MODEL=
JIP_AI_MATCH_EXPLAIN_MAX_OUTPUT_TOKENS=1000
JIP_AI_MATCH_EXPLAIN_EFFORT=
